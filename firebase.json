{
  "hosting": [
    {
      "target": "shell",
      "public": "dist/shell/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|mjs|json)",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "https://sivaxi.com"
            }
          ]
        }
      ]
    },
    {
      "target": "vixi",
      "public": "dist/vixi/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/remoteEntry.json",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "https://sivaxi.com"
            }
          ]
        },
        {
          "source": "**/*.@(js|mjs|json)",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "https://sivaxi.com"
            }
          ]
        }
      ]
    },
    {
      "target": "portfolio",
      "public": "dist/portfolio/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
  {
    "source": "/remoteEntry.json",
    "headers": [
      {
        "key": "Access-Control-Allow-Origin",
        "value": "https://sivaxi.com"
      },
      {
        "key": "Cache-Control",
        "value": "no-store, max-age=0, must-revalidate"
      }
    ]
  },
  {
    "source": "/importmap.json",
    "headers": [
      {
        "key": "Access-Control-Allow-Origin",
        "value": "https://sivaxi.com"
      },
      {
        "key": "Cache-Control",
        "value": "no-store, max-age=0, must-revalidate"
      }
    ]
  },
  {
    "source": "**/*.@(js|mjs|json)",
    "headers": [
      {
        "key": "Access-Control-Allow-Origin",
        "value": "https://sivaxi.com"
      }
    ]
  }
]
    }
  ]
}